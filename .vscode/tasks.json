      "options": {
        "env": {
          "DEVKITPRO": "/c/devkitPro",
          "DEVKITARM": "/c/devkitPro/devkitARM",
          "PATH": "/c/devkitPro/devkitARM/bin:/c/devkitPro/tools/bin:/usr/bin"
        }
      },
